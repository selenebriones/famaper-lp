# Landing estática de racks industriales. Aquí no corre Laravel: el .htaccess
# de la raíz deja pasar /racks-industriales sin reescribir.

DirectoryIndex index.html

Options -Indexes -MultiViews

# Astro genera un directorio por página (gracias/index.html), así que el índice
# resuelve solo. Si el archivo no existe, 404 normal de Apache.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Los assets llevan hash en el nombre: se pueden cachear sin miedo.
    <FilesMatch "\.(css|js)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(webp|png|jpe?g|svg|ico|mp4|woff2?)$">
        ExpiresDefault "access plus 6 months"
    </FilesMatch>

    # El HTML sí debe revalidarse: es lo que cambia en cada publicación.
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
