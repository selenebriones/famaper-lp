---
// Aviso temporal: los números de la oficina de Monterrey no están
// funcionando. Pedido del cliente el 2026-11-24. Quitar este componente (y su
// import en Layout.astro) en cuanto la línea de Monterrey vuelva a operar.
---
<div
	id="aviso-monterrey-fondo"
	class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-sm p-4 opacity-0 pointer-events-none transition-opacity duration-300"
>
	<div
		id="aviso-monterrey"
		class="w-full max-w-lg scale-95 opacity-0 transition-all duration-300"
		style="transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);"
		role="dialog"
		aria-modal="true"
		aria-labelledby="aviso-monterrey-titulo"
	>
		<div class="relative overflow-hidden rounded-3xl bg-brand-surface shadow-2xl shadow-black/30">
			<div class="relative overflow-hidden bg-brand-dark px-8 pt-10 pb-8 text-center">
				<div class="pointer-events-none absolute -top-16 -right-16 h-56 w-56 rounded-full bg-brand-primary/15 blur-3xl"></div>
				<div class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-brand-primary/15 blur-3xl"></div>

				<button
					type="button"
					id="aviso-monterrey-cerrar"
					class="absolute top-4 right-4 flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
					aria-label="Cerrar aviso"
				>
					<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>

				<span class="relative inline-flex items-center rounded-full bg-brand-primary px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-black">
					Aviso importante
				</span>

				<div class="relative mt-6 flex justify-center">
					<span class="relative flex h-20 w-20 items-center justify-center rounded-full bg-brand-primary/20">
						<span class="aviso-monterrey-pulso absolute inset-0 rounded-full bg-brand-primary/40"></span>
						<svg viewBox="0 0 24 24" class="relative h-9 w-9 text-brand-primary" fill="currentColor">
							<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/>
						</svg>
						<span class="absolute -bottom-1 -right-1 flex h-7 w-7 items-center justify-center rounded-full bg-brand-dark border-2 border-brand-surface">
							<svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-red-400" fill="none" stroke="currentColor" stroke-width="3">
								<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
							</svg>
						</span>
					</span>
				</div>

				<h2 id="aviso-monterrey-titulo" class="relative mt-5 text-2xl sm:text-3xl font-extrabold leading-tight text-white">
					La línea de Monterrey no está funcionando
				</h2>
			</div>

			<div class="px-8 py-7 text-center">
				<p class="text-sm sm:text-base leading-relaxed text-brand-muted">
					Para que no te quedes sin atención, comunícate directo con Planta. Con gusto te ayudamos desde ahí, sin esperas:
				</p>

				<a
					href="tel:+523347575181"
					class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-6 py-4 text-lg font-extrabold text-black shadow-lg shadow-brand-primary/30 hover:brightness-105 transition-all"
				>
					<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
						<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/>
					</svg>
					33 4757 5181
				</a>
				<p class="mt-3 text-xs text-brand-muted/70">Toca el número para llamar directo a Planta</p>
			</div>
		</div>
	</div>
</div>

<style>
	@keyframes aviso-monterrey-pulso {
		0%, 100% { transform: scale(1); opacity: 0.6; }
		50% { transform: scale(1.6); opacity: 0; }
	}
	.aviso-monterrey-pulso {
		animation: aviso-monterrey-pulso 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}
	@media (prefers-reduced-motion: reduce) {
		.aviso-monterrey-pulso { animation: none; }
	}
</style>

<script>
	const CLAVE = 'aviso-monterrey-cerrado';
	const fondo = document.getElementById('aviso-monterrey-fondo');
	const modal = document.getElementById('aviso-monterrey');
	const cerrar = document.getElementById('aviso-monterrey-cerrar');

	function mostrar() {
		fondo?.classList.remove('opacity-0', 'pointer-events-none');
		modal?.classList.remove('opacity-0', 'scale-95');
		document.body.style.overflow = 'hidden';
	}

	function ocultar() {
		fondo?.classList.add('opacity-0', 'pointer-events-none');
		modal?.classList.add('opacity-0', 'scale-95');
		document.body.style.overflow = '';
		sessionStorage.setItem(CLAVE, '1');
	}

	// Pausa breve antes de aparecer: se siente a propósito, no como un corte de
	// golpe en cuanto carga la página.
	if (fondo && modal && !sessionStorage.getItem(CLAVE)) {
		setTimeout(mostrar, 900);
	}

	cerrar?.addEventListener('click', ocultar);
	document.addEventListener('keydown', (evento) => {
		if (evento.key === 'Escape') ocultar();
	});
</script>
