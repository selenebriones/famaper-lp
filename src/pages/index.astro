---
import Layout from '../layouts/Layout.astro';

const servicios = [
	{
		icon: 'ph-chats-circle',
		title: 'Consultoría',
		description:
			'Optimizamos tu espacio de almacenaje y el diseño de tu Centro de Distribución (CEDIS). Analizamos el flujo de trabajo para seleccionar los racks de almacenamiento ideales para tu empresa.',
	},
	{
		icon: 'ph-compass-tool',
		title: 'Diseño',
		description:
			'Desarrollamos proyectos a la medida evaluando la capacidad de carga y requerimientos técnicos. Incluye la ingeniería para racks selectivos u otros sistemas con cálculo estructural y sísmico.',
	},
	{
		icon: 'ph-factory',
		title: 'Fabricación',
		description:
			'Como fábrica de racks, producimos tus estructuras con acero de alta resistencia bajo la norma ISO 9001. Nos especializamos en la venta de racks personalizados según las especificaciones de tu bodega.',
